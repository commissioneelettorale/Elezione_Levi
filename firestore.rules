rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function roleIs(roleName) {
      return signedIn() && request.auth.token.role == roleName;
    }

    function activeStaff() {
      let year = request.auth.token.staffYear.replace('/', '_');
      let accounts = 'gestione_accessi_' + year;
      let account = get(/databases/$(database)/documents/artifacts/iis-levi-electoral-v3/public/data/$(accounts)/$(request.auth.token.staffAccountId)).data;
      return account.active != false && account.role == request.auth.token.role
        && account.get('sessionVersion', 0) == request.auth.token.get('sessionVersion', 0)
        && account.get('mustChangePassword', false) != true
        && (request.auth.token.role == 'COMMISSIONE' || (
          request.auth.token.get('staffExpiresAt', 0) * 1000 > request.time.toMillis()
          && account.get('expiresAt', request.time) > request.time));
    }

    function isCommission() {
      return roleIs('COMMISSIONE') && activeStaff() && request.auth.token.mustChangePassword != true;
    }

    function isInstitutionalStaff() {
      return signedIn() && activeStaff() && request.auth.token.role in [
        'COMMISSIONE', 'DIRIGENTE', 'VICEPRESIDE', 'DSGA', 'SEGRETERIA'
      ];
    }

    // Configurazione pubblica necessaria a mostrare calendario, schede e liste.
    // Ogni modifica passa dalla Cloud Function autenticata e viene sottoposta a audit.
    match /artifacts/iis-levi-electoral-v3/public/data/config/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    match /artifacts/iis-levi-electoral-v3/public/data/{collectionId}/{documentId} {
      // Registro degli aventi diritto. Nessun documento può contenere un ID della
      // scheda. La Commissione può leggerlo; la creazione passa dall’API
      // autenticata con audit e controllo dello stato del registro.
      allow read: if isCommission()
        && collectionId == 'tokens_' + request.auth.token.staffYear.replace('/', '_');

      // Importazione e generazione sono atomiche nel backend. Nessun client può
      // scegliere ID o azzerare lo stato di voto tramite la creazione diretta.
      allow create: if false;

      // Anche le rettifiche devono passare da procedure server autorizzate e
      // tracciate: nessuna scrittura può aggirare congelamento o audit via SDK.
      allow update: if false;

      // La cancellazione del registro dal client è sempre vietata.
      allow delete: if false;

      // Chiavi referenti: sola lettura Commissione; scrittura solo Admin SDK.
      allow read: if isCommission()
        && collectionId == 'config_' + request.auth.token.staffYear.replace('/', '_');
      allow write: if false;

      // Account: consultazione attraverso getStaffAccounts, senza hash/salt delle password.
      allow read: if false;
      allow write: if false;

      // URNE: nessun client, neppure Commissione/Dirigenza, legge o scrive
      // direttamente i documenti. Scrutinio e deposito passano dalle Functions.
      allow read, write: if false;
    }

    // Audit amministrativo: accesso solo attraverso API autorizzate e minimizzate.
    match /artifacts/iis-levi-electoral-v3/public/data/audit_admin/{documentId} {
      allow read: if false;
      allow write: if false;
    }

    // Il registro audit_tecnico_YYYY_YYYY resta coperto dal fail-closed generale e
    // viene letto/scritto esclusivamente dall’Admin SDK tramite API server-side.

    // Fail-closed per ogni altro percorso.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
