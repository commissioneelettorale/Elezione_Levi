{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/call.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/call",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
